{% extends 'layout.twig' %}
{% block title %}Print run — {{ requests|length }} records{% endblock %}
{% block content %}
<main id="main" class="print-shell">
  <form method="post" action="/records/batch.pdf" class="print-toolbar noprint">
    {{ csrf_field|raw }}
    {% for id in ids %}<input type="hidden" name="ids[]" value="{{ id }}">{% endfor %}
    <a href="/requests" class="btn btn-on-dark">&#8592; Back</a>
    <h1 style="font-size:12px;font-weight:400;margin:0;color:#fff;">Print run preview — {{ requests|length }} record{{ requests|length == 1 ? '' : 's' }}, {{ requests|length * 2 + 1 }} pages including attachments</h1>
    <button type="submit" class="btn btn-primary">Download / print merged PDF</button>
  </form>

  <div class="sheet">{{ summary_html|raw }}</div>

  {% for html in cover_sheets_html %}
    <div class="sheet">{{ html|raw }}</div>
  {% endfor %}
</main>
{% endblock %}
