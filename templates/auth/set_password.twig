{% extends 'layout.twig' %}
{% block title %}Set your password{% endblock %}
{% block content %}
<main id="main" class="login-shell">
  <div class="login-card">
    <img class="login-card__logo" src="{{ brand_url('login') }}" width="260"
         alt="Argus">
    <h1 style="margin:0 0 8px;font-size:20px;font-weight:700;letter-spacing:.02em;text-transform:uppercase;">
      {{ is_first_login ? 'Set your password' : 'Reset your password' }}
    </h1>
    <p style="margin:0 0 20px;font-size:13px;color:var(--grey);">for {{ user_email }}</p>

    {% if error %}
      <div class="field-error" role="alert" style="margin-bottom:16px;">{{ error }}</div>
    {% endif %}

    <form method="post" action="/set-password/{{ token }}">
      {{ csrf_field|raw }}
      <div class="field">
        <label for="password">New password</label>
        <input id="password" type="password" name="password" required autocomplete="new-password" aria-describedby="pw-hint">
        <span class="field-hint" id="pw-hint">{{ password_hint|default('') }}</span>
      </div>
      <div class="field" style="margin-top:16px;">
        <label for="password_confirm">Confirm password</label>
        <input id="password_confirm" type="password" name="password_confirm" required autocomplete="new-password">
      </div>

      {% if needs_signoff_setup %}
        <div style="margin-top:24px;border-top:2px solid var(--rule);padding-top:18px;">
          <p style="margin:0 0 14px;font-size:13px;color:var(--grey);">Your role signs off on requests, so set a 4-digit PIN now. You can upload a signature image later from your Accounts profile.</p>
          <div class="field">
            <label for="pin">Sign-off PIN (4 digits)</label>
            <input id="pin" type="password" name="pin" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" style="max-width:140px;letter-spacing:.3em;" required>
          </div>
        </div>
      {% endif %}

      <button type="submit" class="btn btn-primary btn-full" style="margin-top:20px;">Save and sign in</button>
    </form>
  </div>
</main>
{% endblock %}
