{# Building blocks for mail/*.html.twig bodies, after the linx email helpers
   (email_heading / email_details / email_button …). All inline-styled. #}

{% macro heading(text) %}
<h1 style="margin:0 0 12px;font-size:21px;line-height:1.3;font-weight:bold;color:#201E1D;">{{ text }}</h1>
{% endmacro %}

{% macro subheading(text) %}
<h2 style="margin:22px 0 8px;font-size:13px;line-height:1.3;font-weight:bold;letter-spacing:1px;text-transform:uppercase;color:#5F5F5F;">{{ text }}</h2>
{% endmacro %}

{% macro p(html) %}
<p style="margin:0 0 14px;">{{ html|raw }}</p>
{% endmacro %}

{# Label / value rows. Empty values are skipped. #}
{% macro details(rows) %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:4px 0 18px;border-top:1px solid #E3E0DC;">
  {% for label, value in rows %}{% if value is not empty %}
  <tr>
    <th align="left" valign="top" scope="row" style="padding:9px 14px 9px 0;border-bottom:1px solid #E3E0DC;font-size:13px;font-weight:bold;color:#5F5F5F;white-space:nowrap;width:1%;">{{ label }}</th>
    <td valign="top" style="padding:9px 0;border-bottom:1px solid #E3E0DC;">{{ value }}</td>
  </tr>
  {% endif %}{% endfor %}
</table>
{% endmacro %}

{# A quoted passage with a gold accent rule (rule is decorative only). #}
{% macro quote(text) %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 18px;">
  <tr><td style="border-left:4px solid #B58358;background:#F4F3F1;padding:12px 16px;white-space:pre-line;">{{ text }}</td></tr>
</table>
{% endmacro %}

{# "Bulletproof" button: the fill lives on the table cell so it survives
   clients that strip padding/background from links. Navy/white = 8.9:1. #}
{% macro button(url, label) %}
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:20px 0 6px;">
  <tr>
    <td style="background:#1C4C7C;">
      <a href="{{ url }}" style="display:inline-block;padding:12px 22px;font-family:Arial, Helvetica, sans-serif;font-size:14px;font-weight:bold;color:#FFFFFF;text-decoration:none;">{{ label }}</a>
    </td>
  </tr>
</table>
{% endmacro %}

{# Fallback link under a button, for clients that block or mangle buttons. #}
{% macro link_fallback(url) %}
<p style="margin:10px 0 0;font-size:12px;color:#5F5F5F;">If the button doesn&rsquo;t work, copy this link into your browser:<br>
<a href="{{ url }}" style="color:#1C4C7C;word-break:break-all;">{{ url }}</a></p>
{% endmacro %}
