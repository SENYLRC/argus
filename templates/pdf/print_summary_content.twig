{# Batch print's page 1: a print-run summary sheet (README §6). Shared by the
   on-screen preview and the real merged PDF, same reasoning as the cover
   sheet partial. #}
{# 672 + 2×72 = 816px (Letter at 96 dpi); content-box because Dompdf ignores box-sizing. #}
<div style="width:672px;min-height:910px;background:#fff;padding:64px 72px;box-sizing:content-box;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.6;color:#201E1D;">
  <div style="border-bottom:2px solid #201E1D;padding-bottom:14px;">
    <div style="font-size:16px;font-weight:bold;">Print run — Expenditure &amp; Encumbrance Requests</div>
    <div style="font-size:11px;letter-spacing:1px;text-transform:uppercase;color:#5F5F5F;margin-top:4px;">Southeastern NY Library Resources Council · {{ today }}</div>
  </div>
  {# Real tabular data (not role="presentation" — unlike the layout-only
     tables elsewhere in this partial and the cover sheet): a screen reader
     reviewing this on screen should get it as an actual table, and Dompdf's
     PDF/UA tagging needs genuine <table>/<th scope> markup to tag it as one
     (build-notes §4b). #}
  <table width="100%" cellpadding="0" cellspacing="0" style="margin-top:20px;font-size:12px;">
    <caption style="caption-side:top;position:absolute;width:1px;height:1px;overflow:hidden;">Requests in this print run, with account, status and amount</caption>
    <thead>
      <tr style="border-bottom:2px solid #201E1D;">
        <th scope="col" style="text-align:left;padding:9px 8px 9px 0;font-size:9px;letter-spacing:1px;text-transform:uppercase;color:#5F5F5F;">Req. no.</th>
        <th scope="col" style="text-align:left;padding:9px 8px;font-size:9px;letter-spacing:1px;text-transform:uppercase;color:#5F5F5F;">Payable to</th>
        <th scope="col" style="text-align:left;padding:9px 8px;font-size:9px;letter-spacing:1px;text-transform:uppercase;color:#5F5F5F;">Account</th>
        <th scope="col" style="text-align:left;padding:9px 8px;font-size:9px;letter-spacing:1px;text-transform:uppercase;color:#5F5F5F;">Status</th>
        <th scope="col" style="text-align:right;padding:9px 0 9px 8px;font-size:9px;letter-spacing:1px;text-transform:uppercase;color:#5F5F5F;">Amount</th>
      </tr>
    </thead>
    <tbody>
      {% for r in rows %}
      <tr style="border-bottom:1px solid #C9C6C2;">
        <td style="padding:10px 8px 10px 0;font-weight:bold;white-space:nowrap;">{{ r.number }}</td>
        <td style="padding:10px 8px;">{{ r.payable_to }}</td>
        <td style="padding:10px 8px;color:#5F5F5F;">{{ r.line_summary }}</td>
        <td style="padding:10px 8px;font-weight:bold;">{{ r.status|capitalize }}</td>
        <td style="padding:10px 0 10px 8px;text-align:right;font-weight:bold;white-space:nowrap;">{{ r.total }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top:2px solid #201E1D;margin-top:14px;padding-top:12px;font-size:15px;">
    <tr>
      <td style="color:#5F5F5F;">{{ count }} in this run</td>
      <td style="text-align:right;"><span style="color:#5F5F5F;">Total:</span> <strong>{{ grand_total }}</strong></td>
    </tr>
  </table>
  <div style="margin-top:34px;border-top:1px solid #5F5F5F;padding-top:10px;font-size:10px;color:#5F5F5F;">Cover sheets follow in the order listed, each with its invoice attached. senylrc.org</div>
</div>
