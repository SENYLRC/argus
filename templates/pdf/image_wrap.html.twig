<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><title>{{ orig_name }}</title><style>@page { size: letter portrait; margin: 0; }</style></head>
<body style="margin:0;">
{# Non-PDF attachments (JPG/PNG receipts) get wrapped onto their own letter-size
   page before merging (build-notes §3). The alt text becomes the PDF's image
   description — a scan of an invoice is an image of text (build-notes §4b 1.1.1). #}
<div style="width:720px;padding:48px;box-sizing:content-box;text-align:center;">
  <img src="{{ data_uri }}" alt="{{ alt_text }}" style="max-width:720px;max-height:960px;">
</div>
</body>
</html>
