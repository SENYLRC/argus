# Argus — server-specific settings. Copy to /var/www/argus/.env on the server
# (deploy/install.sh does this for you on first run and fills in DB_PASSWORD).
# Never commit the real .env or copy it into the dev folder. Permissions:
# root:www-data 640. Real environment variables override anything here.

# Database (Amazon RDS)
DB_HOST=your-database-host.example.com
DB_PORT=3306
DB_NAME=senylrc_expenses
DB_USER=senylrc_expenses
DB_PASSWORD=
# DB_SSL_CA=/var/www/argus/config/rds-global-bundle.pem

# App
APP_ENV=production
# Encrypts two-step sign-in secrets. install.sh generates it; don't change it afterwards.
APP_KEY=
APP_BASE_URL=https://argus.example.org

# Mail — defaults to the local Postfix on localhost:25; uncomment to change.
# SMTP_HOST=localhost
# SMTP_PORT=25
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_ENCRYPTION=

# QuickBooks Online sync (Administration > QuickBooks). From your app at
# developer.intuit.com > Keys & credentials. Register the redirect URI
# https://argus.example.org/admin/quickbooks/callback on that app.
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_ENVIRONMENT=production   # or sandbox while testing
