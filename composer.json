{
    "name": "senylrc/expenditure-requests",
    "description": "Expenditure & Encumbrance Request System for Southeastern NY Library Resources Council",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "bjeavons/zxcvbn-php": "^1.4",
        "chillerlan/php-qrcode": "^5.0",
        "dompdf/dompdf": "^3.1",
        "geoip2/geoip2": "^3.1",
        "lbuchs/webauthn": "^2.2",
        "phpmailer/phpmailer": "^6.9",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6",
        "twig/twig": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
