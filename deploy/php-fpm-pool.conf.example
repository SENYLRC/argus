; A dedicated PHP-FPM pool for Argus, so other PHP sites on a shared server can't read its
; .env (database password, APP_KEY). Not used on servers where Argus runs alone.
;
; 1. adduser --system --group --no-create-home argus
; 2. copy this to /etc/php/<version>/fpm/pool.d/argus.conf, then: systemctl reload php<version>-fpm
; 3. a2enmod proxy_fcgi setenvif, and use the "Dedicated php-fpm pool" block in deploy/vhost.conf
; 4. sudo WEB_USER=argus bash deploy/install.sh   (checks this pool is running, then records the user)

[argus]
user = argus
group = argus

listen = /run/php/php-fpm-argus.sock
; Apache connects to the socket, so it must be readable by Apache's own account.
listen.owner = www-data
listen.group = www-data
listen.mode = 0660

pm = ondemand
pm.max_children = 8
pm.process_idle_timeout = 60s

; What the vhost's php_admin_value lines do under mod_php, for this site only.
php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on
php_admin_value[upload_max_filesize] = 21M
php_admin_value[post_max_size] = 25M
php_admin_value[open_basedir] = /var/www/argus/:/usr/share/GeoIP/:/tmp/
; Sessions live inside the app folder so only this account can read them.
php_admin_value[session.save_path] = /var/www/argus/storage/tmp/sessions
